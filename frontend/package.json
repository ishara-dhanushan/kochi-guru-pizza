{
  "name": "frontend",
  "version": "1.0.0",
  "description": "Next.js frontend application for Kochi Guru Pizza website",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit --maxWorkers=6",
    "test:integration": "vitest run tests/integration",
    "test:unit:coverage": "vitest run tests/unit --maxWorkers=6 --coverage --coverage.reportsDirectory=coverage/unit",
    "test:integration:coverage": "vitest run tests/integration --coverage --coverage.reportsDirectory=coverage/integration",
    "test:coverage": "npm run test:unit:coverage && npm run test:integration:coverage"
  },
  "author": "Ishara Dhanushan",
  "license": "ISC",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.33.0",
    "lucide-react": "^0.563.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^15.0.0",
    "react-hot-toast": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
