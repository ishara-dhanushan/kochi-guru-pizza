{
  "name": "kochi-guru-pizza-e2e",
  "version": "1.0.0",
  "description": "Playwright end-to-end tests for Kochi Guru Pizza",
  "keywords": [
    "playwright",
    "e2e",
    "testing"
  ],
  "license": "ISC",
  "author": "Ishara Dhanushan",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:preflight": "tsx dbPreflight.ts",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "mongodb": "^7.9.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
