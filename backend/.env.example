# Port on which the backend server listens.
PORT=5000

# MongoDB connection string. Replace with your own MongoDB Atlas or local MongoDB URI.
MONGO_DB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# URL of the frontend application, used for CORS and redirect whitelisting.
FRONTEND_URL=http://localhost:3000

# JWT Configuration
# Secret used to sign access tokens. Use a strong, random value in production.
JWT_SECRET=your_jwt_access_token_secret_here
# Access token expiration time (e.g. 1h, 15m, 7d).
JWT_EXPIRES_IN=1h

# Refresh Token Configuration
# Secret used to sign refresh tokens. Use a strong, random value in production.
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here
# Refresh token expiration time (e.g. 30d, 7d).
REFRESH_TOKEN_EXPIRES_IN=30d

# Google OAuth (Add your credentials from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/v1/auth/google/callback

# Cloudflare R2 Configuration (S3-compatible object storage)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_DOMAIN=https://your-bucket.r2.dev
R2_BUCKET_NAME=your-r2-bucket-name

# Maximum number of active sessions allowed per user.
MAX_ACTIVE_SESSIONS=5

# Node environment (development, production, test).
NODE_ENV=development