{
  "name": "kochi-guru-pizza-backend",
  "version": "1.0.0",
  "description": "Express.js backend application for Kochi Guru Pizza website",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run lint && tsc && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.config.cjs",
    "test:unit:coverage": "jest --config jest.config.cjs --coverage",
    "test:integration": "jest --config jest.integration.config.mjs",
    "test:integration:coverage": "jest --config jest.integration.config.mjs --coverage",
    "test:typecheck": "tsc -p tests/tsconfig.json --noEmit"
  },
  "author": "Ishara Dhanushan",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.1.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.3.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "supertest": "^7.3.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
